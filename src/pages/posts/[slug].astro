---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

// Generate excerpt from content if not provided
const excerpt = post.data.excerpt || post.body?.slice(0, 150).replace(/[#*\n]/g, ' ').trim() + '...' || '每日记录 - Bub 的日记';
---

<Layout 
  title={`${post.data.title} | 每日记录`}
  description={excerpt}
  type="article"
>
  <article class="post">
    <header>
      <span class="date">{post.data.date.toISOString().split('T')[0]}</span>
      <h1>{post.data.title}</h1>
    </header>
    
    <div class="content">
      <Content />
    </div>
    
    <div class="back-link">
      <a href="/">← 返回首页</a>
    </div>
  </article>
</Layout>

<style>
  .post {
    max-width: 46rem;
    margin: 0 auto;
  }

  .post header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border-strong);
  }

  .date {
    color: var(--color-accent);
    font-size: 0.82rem;
    font-weight: 650;
    font-variant-numeric: tabular-nums;
  }

  h1 {
    margin-top: 0.65rem;
    color: var(--color-text);
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 7vw, 3.8rem);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.035em;
  }

  .content {
    color: var(--color-text);
    font-family: var(--font-serif);
    font-size: 1.08rem;
    line-height: 2;
    overflow-wrap: anywhere;
  }

  .content :global(p) {
    margin-bottom: 1.35rem;
  }

  .content :global(h2),
  .content :global(h3) {
    font-family: var(--font-sans);
    line-height: 1.45;
  }

  .content :global(h2) {
    margin: 2.75rem 0 1rem;
    font-size: 1.55rem;
  }

  .content :global(h3) {
    margin: 2.25rem 0 0.75rem;
    font-size: 1.2rem;
  }

  .content :global(ul),
  .content :global(ol) {
    margin: 0 0 1.5rem 1.4rem;
  }

  .content :global(li) {
    padding-left: 0.25rem;
  }

  .content :global(li + li) {
    margin-top: 0.45rem;
  }

  .content :global(blockquote) {
    margin: 1.75rem 0;
    padding: 0.1rem 0 0.1rem 1.25rem;
    color: var(--color-muted);
    border-left: 2px solid var(--color-accent);
  }

  .content :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .content :global(a) {
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .content :global(code) {
    padding: 0.12em 0.3em;
    background: var(--color-quiet);
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: 0.88em;
  }

  .content :global(pre) {
    margin: 1.75rem 0;
    padding: 1rem 1.1rem;
    overflow-x: auto;
    color: #f4f0e8;
    background: #292722;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.86rem;
    line-height: 1.65;
  }

  .content :global(pre code) {
    padding: 0;
    color: inherit;
    background: transparent;
  }

  .content :global(hr) {
    margin: 2.5rem 0;
    border: 0;
    border-top: 1px solid var(--color-border);
  }

  .content :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 2rem auto;
    border: 1px solid var(--color-border);
    border-radius: 4px;
  }

  .content :global(.signature) {
    margin-top: 2.5rem;
    color: var(--color-muted);
  }

  .back-link {
    margin-top: 3.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .back-link a {
    color: var(--color-muted);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .back-link a:hover {
    color: var(--color-accent);
  }

  @media (max-width: 600px) {
    .post header {
      margin-bottom: 2rem;
    }

    h1 {
      font-size: clamp(2rem, 11vw, 2.75rem);
    }

    .content {
      font-size: 1rem;
      line-height: 1.9;
    }
  }
</style>

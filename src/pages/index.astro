---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Calendar from '../components/Calendar.jsx';

const allPosts = (await getCollection('posts')).sort(
  (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
);

// Keep the home page focused on the most recent week.
const sevenDaysAgo = new Date();
sevenDaysAgo.setDate(sevenDaysAgo.getDate() - 7);
sevenDaysAgo.setHours(0, 0, 0, 0);

const posts = allPosts.filter(post => new Date(post.data.date) >= sevenDaysAgo);
const latestPost = allPosts[0];
const totalMonths = new Set(
  allPosts.map(post => {
    const date = new Date(post.data.date);
    return `${date.getFullYear()}-${date.getMonth() + 1}`;
  })
).size;
const latestDate = latestPost?.data.date.toISOString().split('T')[0] ?? '暂无';
---

<Layout
  title="每日记录"
  description="把日常里的判断、感想与片刻灵感，整理成持续可回看的文字轨迹。"
>
  <div class="archive-grid">
    <section class="intro" aria-labelledby="page-title">
      <h1 id="page-title">每日记录</h1>
      <p class="subtitle">把日常里的判断、感想与片刻灵感，整理成持续可回看的文字轨迹。</p>

      <dl class="archive-meta">
        <div>
          <dt>最近更新</dt>
          <dd><time datetime={latestPost ? latestDate : undefined}>{latestDate}</time></dd>
        </div>
        <div>
          <dt>记录</dt>
          <dd>{allPosts.length} 篇</dd>
        </div>
        <div>
          <dt>时间跨度</dt>
          <dd>{totalMonths} 个月</dd>
        </div>
      </dl>
    </section>

    <aside class="archive-sidebar" aria-label="按日期浏览">
      <p class="sidebar-title">按日期浏览</p>
      <Calendar posts={allPosts} client:load />
    </aside>

    <section class="posts" aria-labelledby="recent-title">
      <div class="section-heading">
        <h2 id="recent-title">最近七天</h2>
        <p>按更新时间倒序排列。</p>
      </div>

      {posts.length > 0 ? (
        <div class="post-list">
          {posts.map((post) => {
            const postDate = post.data.date.toISOString().split('T')[0];
            return (
              <article class="post-row">
                <time class="date" datetime={postDate}>{postDate}</time>
                <div class="post-summary">
                  <h3>
                    <a href={`/posts/${post.slug}`}>{post.data.title}</a>
                  </h3>
                  <p>{post.data.excerpt}</p>
                </div>
              </article>
            );
          })}
        </div>
      ) : (
        <p class="no-posts">最近七天没有日记记录。</p>
      )}
    </section>
  </div>
</Layout>

<style>
  .archive-grid {
    max-width: 1120px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 17.5rem;
    grid-template-areas:
      'intro sidebar'
      'posts sidebar';
    column-gap: 4rem;
    row-gap: 3.5rem;
    align-items: start;
  }

  .intro {
    grid-area: intro;
    padding: 0.5rem 0 2.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  .intro h1 {
    margin: 0 0 1rem;
    color: var(--color-text);
    font-family: var(--font-serif);
    font-size: clamp(3.25rem, 7vw, 5.5rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.02em;
  }

  .subtitle {
    max-width: 36rem;
    margin: 0;
    color: var(--color-muted);
    font-family: var(--font-serif);
    font-size: 1.08rem;
    line-height: 1.85;
  }

  .archive-meta {
    display: grid;
    grid-template-columns: 1.45fr 0.75fr 0.8fr;
    margin-top: 2.25rem;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .archive-meta > div {
    min-width: 0;
    padding: 0.9rem 1.25rem;
    border-left: 1px solid var(--color-border);
  }

  .archive-meta > div:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .archive-meta dt {
    color: var(--color-muted);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .archive-meta dd {
    margin-top: 0.25rem;
    color: var(--color-text);
    font-size: 0.98rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .archive-sidebar {
    grid-area: sidebar;
    position: sticky;
    top: 1.5rem;
    min-width: 0;
  }

  .sidebar-title {
    margin-bottom: 0.6rem;
    color: var(--color-muted);
    font-size: 0.78rem;
    font-weight: 650;
  }

  .posts {
    grid-area: posts;
    min-width: 0;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 2rem;
    margin-bottom: 1rem;
  }

  .section-heading h2 {
    font-family: var(--font-serif);
    font-size: 1.8rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .section-heading p {
    color: var(--color-muted);
    font-size: 0.86rem;
  }

  .post-list {
    border-top: 1px solid var(--color-border-strong);
  }

  .post-row {
    display: grid;
    grid-template-columns: 7.25rem minmax(0, 1fr);
    gap: 1.75rem;
    padding: 1.55rem 0 1.65rem;
    border-bottom: 1px solid var(--color-border);
  }

  .date {
    padding-top: 0.22rem;
    color: var(--color-muted);
    font-size: 0.78rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .post-summary h3 {
    margin: 0 0 0.55rem;
    font-family: var(--font-serif);
    font-size: 1.38rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .post-summary h3 a {
    color: var(--color-text);
    text-decoration: none;
    transition: color 160ms ease;
  }

  .post-summary h3 a:hover {
    color: var(--color-accent);
  }

  .post-summary p {
    color: var(--color-muted);
    font-family: var(--font-serif);
    font-size: 0.94rem;
    line-height: 1.8;
  }

  .no-posts {
    padding: 1.5rem 0;
    color: var(--color-muted);
    border-top: 1px solid var(--color-border-strong);
    border-bottom: 1px solid var(--color-border);
  }

  @media (max-width: 960px) {
    .archive-grid {
      max-width: 46rem;
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'intro'
        'sidebar'
        'posts';
      row-gap: 2.75rem;
    }

    .archive-sidebar {
      position: static;
      width: min(100%, 25rem);
    }
  }

  @media (max-width: 600px) {
    .intro {
      padding: 0 0 2rem;
    }

    .intro h1 {
      font-size: clamp(2.8rem, 15vw, 3.75rem);
      letter-spacing: -0.02em;
    }

    .subtitle {
      font-size: 1rem;
      line-height: 1.75;
    }

    .archive-meta {
      grid-template-columns: 1.25fr 0.7fr 0.8fr;
      margin-top: 1.75rem;
    }

    .archive-meta > div {
      padding: 0.75rem 0.55rem;
    }

    .archive-meta > div:first-child {
      padding-left: 0;
    }

    .section-heading {
      display: block;
    }

    .section-heading p {
      margin-top: 0.35rem;
    }

    .post-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.45rem;
      padding: 1.3rem 0 1.45rem;
    }

    .date {
      padding-top: 0;
    }

    .post-summary h3 {
      font-size: 1.25rem;
    }
  }
</style>
